<Window x:Class="MyNotch.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyNotch Dock" Width="800" Height="104"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- One template for pinned and open apps. Size is animated for the zoom effect. -->
        <DataTemplate x:Key="DockItemTemplate">
            <Button Style="{StaticResource DockButton}" Width="{Binding Size}" Height="{Binding Size}"
                    VerticalAlignment="Bottom" ToolTip="{Binding Title}" Click="Item_Click" Tag="{Binding}">
                <Grid>
                    <!-- 100x100 design inside a Viewbox so it scales with the zoom.
                         No background; full-square icons get rounded corners (squircle). -->
                    <Viewbox Margin="5">
                        <Grid Width="100" Height="100">
                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,100,100" RadiusX="23" RadiusY="23"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Viewbox>
                    <Border Width="{Binding IndicatorWidth}" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom"
                            Margin="0,0,0,-4" Background="{DynamicResource AccentBrush}"/>
                </Grid>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Close all windows" Click="CloseWindows_Click" Tag="{Binding}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Row">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <!-- Layered window: transparent pixels are click-through; icons may grow beyond the card. -->
    <Grid x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" MouseMove="Root_MouseMove">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Windows taskbar settings" Click="TaskbarSettings_Click"/>
                <Separator/>
                <MenuItem Header="Quit and restore taskbar" Click="Exit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Card: fixed height. Glass = blurred screen capture + tint; alpha-1 background so gaps between icons catch the mouse. -->
        <Border x:Name="Bar" Height="56" VerticalAlignment="Bottom" CornerRadius="18"
                Background="#01000000" BorderThickness="1">
            <Grid>
                <Canvas IsHitTestVisible="False"><Image x:Name="BackdropImage"/></Canvas> <!-- Canvas: image size doesn't affect layout -->
                <Border x:Name="Tint" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Icons: bottom-aligned, may grow beyond the card -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,8,6">
            <Button Style="{StaticResource DockButton}" VerticalAlignment="Bottom" ToolTip="Start" Click="Start_Click">
                <Grid>
                <Image x:Name="StartIcon" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                <UniformGrid x:Name="StartSquares" Rows="2" Columns="2" Width="20" Height="20">
                    <Rectangle Fill="{DynamicResource AccentBrush}" Margin="1" RadiusX="1.5" RadiusY="1.5"/>
                    <Rectangle Fill="{DynamicResource AccentBrush}" Margin="1" RadiusX="1.5" RadiusY="1.5"/>
                    <Rectangle Fill="{DynamicResource AccentBrush}" Margin="1" RadiusX="1.5" RadiusY="1.5"/>
                    <Rectangle Fill="{DynamicResource AccentBrush}" Margin="1" RadiusX="1.5" RadiusY="1.5"/>
                </UniformGrid>
                </Grid>
            </Button>
            <Rectangle Width="1" Height="28" Fill="#44888888" Margin="6,0,6,8" VerticalAlignment="Bottom"/>
            <ItemsControl x:Name="Pinned" ItemTemplate="{StaticResource DockItemTemplate}" ItemsPanel="{StaticResource Row}" VerticalAlignment="Bottom"/>
            <Rectangle x:Name="RunningSep" Width="1" Height="28" Fill="#44888888" Margin="6,0,6,8" VerticalAlignment="Bottom"/>
            <ItemsControl x:Name="Running" ItemTemplate="{StaticResource DockItemTemplate}" ItemsPanel="{StaticResource Row}" VerticalAlignment="Bottom"/>
            <Rectangle Width="1" Height="28" Fill="#44888888" Margin="6,0,6,8" VerticalAlignment="Bottom"/>
            <StackPanel VerticalAlignment="Bottom" Height="44" Margin="4,0,4,0">
                <TextBlock x:Name="DockTime" Foreground="{DynamicResource DockFg}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                <TextBlock x:Name="DockDate" Foreground="{DynamicResource DockFg}" Opacity="0.7" FontSize="11" HorizontalAlignment="Right"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
